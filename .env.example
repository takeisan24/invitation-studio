# ==========================================
# CUỘC HẸN NHỎ (A Quiet Date Invitation Studio)
# Environment Variables Configuration
# ==========================================

# Vercel Blob (short invite links + background/music uploads)
# Set automatically when you connect a Blob store to the Vercel project.
# Leave empty locally to test the database-free #c= links only.
BLOB_READ_WRITE_TOKEN=

# Protects the weekly cleanup cron (/api/cron/cleanup). Any long random string.
CRON_SECRET=

# Production Domain URL
# Used for OpenGraph preview metadata, sitemap.xml, and robots.txt
NEXT_PUBLIC_APP_URL=https://cuochennho.vercel.app
